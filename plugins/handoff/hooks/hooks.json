{
  "description": "Session continuity: load the last handoff at startup and after /clear; write an automatic snapshot when a session ends.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/handoff.py\" start",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/handoff.py\" end",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
